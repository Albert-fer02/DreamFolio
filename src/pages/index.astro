---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/ui/Navbar';
import { siteConfig, withBase } from '../lib/site';
import '../styles/portfolio.css';
import Icon from '../components/ui/Icon.astro';
import ProfileCard from '../components/ui/ProfileCard.astro';
const modules = [
  ['drenyra-ai', 'Configuración', 'Entorno y herramientas para trabajar con IA.'],
  ['drenyra-pi', 'Agentes', 'Flujos de trabajo especializados en contabilidad.'],
  ['drenyra-engram', 'Memoria', 'Contexto y decisiones con trazabilidad.'],
];
---
<BaseLayout title={siteConfig.title} description={siteConfig.description} lang="es">
  <Navbar client:load />
  <main id="main-content" class="portfolio">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-eyebrow"><span class="mono">ALBERT AGURTO / DREAMCODER</span><span class="location"><Icon name="location" size={15}/> Desde Perú, para el mundo</span></div>
      <div class="hero-grid">
        <div>
          <h1 id="hero-title">De la idea<br/>al <span>sistema.</span></h1>
          <p class="hero-description">Diseño y construyo software con IA.<br class="desktop-break"/> Con criterio de arquitectura, interfaces claras<br class="desktop-break"/> y decisiones que se pueden explicar.</p>
          <div class="actions"><a class="solid-link" href="#projects">Explorar mi trabajo <Icon name="down" size={18}/></a><a class="quiet-link" href={siteConfig.social.github}><Icon name="github" size={20}/>GitHub <Icon name="arrow" size={18}/></a></div>
        </div>
        <ProfileCard />
      </div>
      <div class="hero-bottom"><span><Icon name="layers" size={17}/> ARQUITECTURA DE SOFTWARE</span><span><Icon name="agents" size={17}/> SISTEMAS DE IA</span><span><Icon name="code" size={17}/> DESARROLLO DE PRODUCTO</span><span class="hero-index">PORTAFOLIO / 2026</span></div>
    </section>

    <section id="projects" class="work-section wrap" aria-labelledby="work-title" data-reveal>
      <div class="section-heading"><div><p class="eyebrow">01 / TRABAJO SELECCIONADO</p><h2 id="work-title">Ideas en construcción.<br/><span>Código para explorarlas.</span></h2></div><a class="quiet-link" href={withBase('/projects/')}>Todos los proyectos <Icon name="arrow" size={18}/></a></div>
      <article class="featured-project" data-reveal>
        <a class="project-visual" href={withBase('/projects/drenyra-fiscal-command-center/')} aria-label="Explorar el proyecto Drenyra"><div class="visual-label"><span>ARKELYTHEX / DRENYRA</span><span>01</span></div><img src={withBase('/images/projects/arkelythex-interface.jpg')} width="1920" height="1080" alt="Interfaz de una etapa anterior del prototipo contable de Arkelythex, con consultas y herramientas contables" loading="lazy"/><span class="visual-caption">Interfaz del prototipo · Archivo del proyecto</span></a>
        <div class="project-content"><p class="eyebrow">PRODUCTO PRINCIPAL / IA + CONTABILIDAD</p><h3>Drenyra</h3><p class="project-lead">Un espacio de trabajo<br/>para la contabilidad con IA.</p><p>Estoy construyendo un sistema que conecta agentes, contexto y revisión profesional para asistir el trabajo contable en Perú y Latinoamérica.</p><p class="project-principle"><Icon name="evidence" size={20}/>La IA asiste. El sistema valida.<br/>El profesional revisa. La evidencia permanece.</p><div class="tags"><span>TypeScript</span><span>Go</span><span>React</span><span>PostgreSQL</span></div><div class="project-links"><a href="https://arkelythex.com/drenyra">Conocer Drenyra <Icon name="arrow" size={17}/></a><a href="https://github.com/arkelythex">Código <Icon name="arrow" size={17}/></a></div></div>
      </article>
      <div class="project-pair">
        <article class="small-project"><a class="small-visual terminal-visual" href={withBase('/projects/dreamcoder-dots/')} aria-label="Explorar Dreamcoder Dots" data-reveal><img src={withBase('/images/projects/dreamcoder-dots.webp')} alt="Entorno de terminal de Dreamcoder Dots sobre Arch Linux" width="1600" height="900" loading="lazy"/></a><div class="small-project-heading"><div><p class="eyebrow"><Icon name="terminal" size={16}/> 02 / HERRAMIENTAS PARA DESARROLLAR</p><h3>Dreamcoder Dots</h3></div><a href="https://github.com/Dreamcoder08/Dreamcoder_dots" class="circle-link" aria-label="Código de Dreamcoder Dots"><Icon name="arrow" size={20}/></a></div><p>Mi entorno de trabajo en Arch Linux: configuración, terminal y herramientas adaptadas a cómo construyo software.</p><div class="tags"><span>Arch Linux</span><span>Shell</span><span>Lua</span></div></article>
        <article class="small-project"><a class="small-visual" href={withBase('/projects/digital-public-peru/')} aria-label="Explorar Digital Public Peru" data-reveal><img src={withBase('/images/projects/digital-public-peru-desktop.png')} alt="Interfaz del proyecto Digital Public Peru" width="1600" height="900" loading="lazy"/></a><div class="small-project-heading"><div><p class="eyebrow"><Icon name="globe" size={16}/> 03 / TECNOLOGÍA CÍVICA</p><h3>Digital Public Peru</h3></div><a href="https://github.com/arkelythex/Digital_Public_peru" class="circle-link" aria-label="Código de Digital Public Peru"><Icon name="arrow" size={20}/></a></div><p>Exploración de herramientas para consultar información pública y acercar la tecnología a la transparencia en Perú.</p><div class="tags"><span>Rust</span><span>Next.js</span><span>OpenAPI</span></div></article>
      </div>
    </section>

    <section id="about" class="about-section" data-reveal><div class="wrap about-grid"><div><p class="eyebrow">02 / DETRÁS DEL CÓDIGO</p><h2>Autodidacta.<br/>Curioso por naturaleza.<br/><span>Constructor por elección.</span></h2></div><div class="about-copy"><p>Soy Albert Agurto, también conocido como <strong>Dreamcoder</strong>. Desde Piura, Perú, conecto mis intereses en software, inteligencia artificial y contabilidad para construir herramientas útiles.</p><p>Fundé <a href="https://arkelythex.com/">Arkelythex</a> como laboratorio de productos de software e IA. Hoy mi foco está en Drenyra y en el ecosistema que lo hace posible.</p><p>Aprendo construyendo, leyendo código y cuestionando decisiones. Me interesa tanto lo que ve una persona en pantalla como lo que permite que el sistema funcione por dentro.</p><a class="quiet-link" href={siteConfig.social.github}><Icon name="github" size={18}/>Conoce mi trabajo en GitHub <Icon name="arrow" size={17}/></a></div></div></section>

    <section id="architecture" class="principles-section wrap" data-reveal><div class="section-heading"><div><p class="eyebrow">03 / FORMA DE TRABAJAR</p><h2>La ambición necesita<br/><span>criterio técnico.</span></h2></div><p class="heading-note">Tres principios que guían<br/>lo que estoy construyendo.</p></div><div class="principles"><article data-reveal><div class="principle-top"><span class="principle-icon"><Icon name="layers" size={25}/></span><span class="principle-number">01</span></div><h3>Diseñar antes de escalar.</h3><p>Definir el problema, separar responsabilidades y hacer explícitos los límites. Elegir la complejidad que el producto necesita.</p></article><article data-reveal><div class="principle-top"><span class="principle-icon"><Icon name="agents" size={25}/></span><span class="principle-number">02</span></div><h3>IA con supervisión.</h3><p>Dar a los agentes contexto y herramientas. Reservar las decisiones sensibles para reglas verificables y revisión humana.</p></article><article data-reveal><div class="principle-top"><span class="principle-icon"><Icon name="evidence" size={25}/></span><span class="principle-number">03</span></div><h3>Construir para entender.</h3><p>Código legible, documentación útil y pruebas en los puntos críticos. Poder explicar una decisión y volver a ella.</p></article></div><div class="toolbelt"><span class="mono">EN MI ENTORNO</span><p>TypeScript <span>/</span> React <span>/</span> Go <span>/</span> Rust <span>/</span> Python <span>/</span> Linux</p></div></section>

    <section id="opensource" class="open-section wrap" data-reveal><div class="section-heading"><div><p class="eyebrow">04 / ECOSISTEMA ABIERTO</p><h2>Un producto.<br/><span>Piezas con propósito.</span></h2></div><a href="https://github.com/arkelythex" class="quiet-link">Explorar Arkelythex <Icon name="arrow" size={17}/></a></div><div class="module-list">{modules.map(([name, label, description], i) => <a href={`https://github.com/arkelythex/${name}`} class="module-row" data-reveal><span class="module-icon"><Icon name={(["terminal","agents","memory"] as const)[i]} size={23}/></span><h3>{name}</h3><span class="module-label">{label}</span><p>{description}</p><Icon name="arrow" size={18}/></a>)}</div></section>

    <section id="connect" class="contact-section wrap" data-reveal><div class="contact-top"><p class="eyebrow">05 / SIGUIENTE CONVERSACIÓN</p><span class="mono">PIURA, PERÚ · UTC−5</span></div><h2>¿Algo interesante<br/>por <span>construir?</span></h2><div class="contact-bottom"><p>Conversemos sobre oportunidades en desarrollo,<br/>productos con IA o colaboraciones técnicas.</p><a class="solid-link" href="mailto:albertagurtofarfanalbert@gmail.com"><Icon name="mail" size={20}/>Hablemos por correo <Icon name="arrow" size={18}/></a></div><div class="contact-social"><a href={siteConfig.social.github}><Icon name="github" size={18}/>GitHub <Icon name="arrow" size={15}/></a><a href={siteConfig.social.x}><Icon name="x" size={17}/>X / Twitter <Icon name="arrow" size={15}/></a><a href="https://arkelythex.com/"><Icon name="mark" size={18}/>Arkelythex <Icon name="arrow" size={15}/></a></div></section>
  </main>
  <footer class="site-footer wrap"><a href={withBase('/')}><Icon name="mark" size={24}/> <strong>dreamcoder</strong></a><p>© {new Date().getFullYear()} Albert Agurto</p><a href="#main-content">Volver arriba <Icon name="up" size={16}/></a></footer>
</BaseLayout>
